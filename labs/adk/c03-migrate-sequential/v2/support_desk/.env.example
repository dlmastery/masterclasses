# copy to .env in this folder
# FALSE = Gemini API key (AI Studio); TRUE = Agent Platform (Vertex AI)
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=<your AI Studio key>
